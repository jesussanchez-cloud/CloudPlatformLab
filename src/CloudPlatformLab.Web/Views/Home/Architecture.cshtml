@{
    ViewData["Title"] = "Architecture";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1>CloudPlatformLab Architecture</h1>

        <p class="lead">
            A production-oriented Azure platform demonstrating cloud-native
            application development, data engineering, security,
            infrastructure as code and DevOps.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3>Identity & Security</h3>
                    <ul>
                        <li>Microsoft Entra ID</li>
                        <li>Managed Identities</li>
                        <li>Azure Key Vault</li>
                        <li>Azure RBAC</li>
                        <li>Azure Policy</li>
                        <li>Defender for Cloud</li>
                        <li>Private Endpoints</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3>Application & APIs</h3>
                    <ul>
                        <li>ASP.NET Core .NET 8</li>
                        <li>Azure App Service</li>
                        <li>Deployment Slots</li>
                        <li>API Management</li>
                        <li>AKS</li>
                        <li>Docker</li>
                        <li>Container Registry</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3>Data Platform</h3>
                    <ul>
                        <li>Azure SQL</li>
                        <li>Cosmos DB</li>
                        <li>Blob Storage</li>
                        <li>Data Lake Storage Gen2</li>
                        <li>Service Bus</li>
                        <li>Event Hubs</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3>Data Engineering</h3>
                    <ul>
                        <li>Microsoft Fabric</li>
                        <li>Fabric Data Factory</li>
                        <li>Fabric Lakehouse</li>
                        <li>Fabric Warehouse</li>
                        <li>Power BI</li>
                        <li>Azure Synapse</li>
                        <li>Azure Databricks</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3>Observability</h3>
                    <ul>
                        <li>Azure Monitor</li>
                        <li>Application Insights</li>
                        <li>Log Analytics</li>
                        <li>Alerts</li>
                        <li>Health Checks</li>
                        <li>Distributed Tracing</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3>DevOps & IaC</h3>
                    <ul>
                        <li>GitHub</li>
                        <li>GitHub Actions</li>
                        <li>Azure DevOps</li>
                        <li>Bicep</li>
                        <li>Terraform</li>
                        <li>Automated Testing</li>
                        <li>CI/CD</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3>FinOps & Governance</h3>
                    <ul>
                        <li>Azure Cost Management</li>
                        <li>Budgets & Cost Alerts</li>
                        <li>Resource Tagging</li>
                        <li>Cost Allocation</li>
                        <li>Right-Sizing</li>
                        <li>Non-Production Cost Controls</li>
                        <li>Azure Policy</li>
                        <li>Cloud Cost Optimization</li>
                    </ul>
                </div>
            </div>
        </div>

    </div>
</div>