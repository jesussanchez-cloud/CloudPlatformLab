@{
    ViewData["Title"] = "Architecture";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1>CloudPlatformLab Architecture</h1>

        <p class="lead">
            A production-oriented Azure cloud platform demonstrating
            application architecture, platform engineering, security,
            infrastructure as code, CI/CD, observability and FinOps.
        </p>
    </div>

    <div class="row g-4">

        <!-- Identity & Security -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3>Identity &amp; Security</h3>
                    <ul>
                        <li>Microsoft Entra ID</li>
                        <li>Managed Identities</li>
                        <li>Azure Key Vault</li>
                        <li>Azure RBAC</li>
                        <li>Azure Policy</li>
                        <li>Private Endpoints</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Application & APIs -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3>Application &amp; APIs</h3>
                    <ul>
                        <li>ASP.NET Core .NET 8</li>
                        <li>Azure App Service</li>
                        <li>Deployment Slots</li>
                        <li>API Management</li>
                        <li>AKS</li>
                        <li>Docker</li>
                        <li>Container Registry</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Data & Messaging -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3>Data &amp; Messaging</h3>
                    <ul>
                        <li>Azure SQL</li>
                        <li>Blob Storage</li>
                        <li>Service Bus</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Observability -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3>Observability</h3>
                    <ul>
                        <li>Azure Monitor</li>
                        <li>Application Insights</li>
                        <li>Log Analytics</li>
                        <li>Alerts</li>
                        <li>Health Checks</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- DevOps & IaC -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3>DevOps &amp; IaC</h3>
                    <ul>
                        <li>GitHub</li>
                        <li>GitHub Actions</li>
                        <li>Azure DevOps</li>
                        <li>Bicep</li>
                        <li>Terraform</li>
                        <li>Automated Testing</li>
                        <li>CI/CD</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- FinOps -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h3>FinOps</h3>
                    <ul>
                        <li>Azure Cost Management</li>
                        <li>Budgets &amp; Cost Alerts</li>
                        <li>Resource Tagging</li>
                        <li>Right-Sizing</li>
                        <li>Non-Production Cost Controls</li>
                    </ul>
                </div>
            </div>
        </div>

    </div>

    <!-- Engineering Principles -->
    <div class="mt-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3>Engineering Principles</h3>

                <div class="row g-3 mt-1">

                    <div class="col-md-6 col-lg-4">
                        <div class="p-3 bg-light rounded">
                            <strong>Infrastructure as Code</strong>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="p-3 bg-light rounded">
                            <strong>Least-Privilege Security</strong>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="p-3 bg-light rounded">
                            <strong>Managed Identity over Secrets</strong>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="p-3 bg-light rounded">
                            <strong>Automated Testing &amp; Validation</strong>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="p-3 bg-light rounded">
                            <strong>Observability by Design</strong>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="p-3 bg-light rounded">
                            <strong>Repeatable Deployments</strong>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="p-3 bg-light rounded">
                            <strong>Cost-Aware Architecture</strong>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="p-3 bg-light rounded">
                            <strong>Environment Isolation</strong>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="p-3 bg-light rounded">
                            <strong>Evidence-Driven Engineering</strong>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>