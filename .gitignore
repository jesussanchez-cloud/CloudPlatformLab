## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Based on:
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore


# ============================================================
# CloudPlatformLab - Security / Local Configuration
# ============================================================

# Environment files - may contain secrets
.env
.env.*
*.env
!.env.example

# Local ASP.NET configuration
appsettings.Local.json
appsettings.*.Local.json

# Generic local secret / credential files
secrets.json
*.secrets.json
credentials.json
*.credentials.json

# Private keys and certificates
*.key
*.pem
*.p12
*.pfx
*.snk

# Azure publishing / deployment credentials
*.publishsettings
*.azurePubxml

# Kubernetes local credentials / configuration
.kube/
kubeconfig
*.kubeconfig


# ============================================================
# Terraform
# ============================================================

# Terraform working directories
**/.terraform/*

# Terraform state files
# State can contain sensitive infrastructure information
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan
tfplan

# Terraform variable files may contain secrets or local values
*.tfvars
*.tfvars.json

# Safe example variable files may be committed
!*.tfvars.example
!*.tfvars.json.example

# Terraform crash logs
crash.log
crash.*.log

# Local Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# DO NOT ignore .terraform.lock.hcl
# It should be committed for reproducible provider versions


